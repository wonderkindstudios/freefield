      "clip": [
        "15",
        0
      ],
      "vae": [
        "16",
        0
      ],
      "ref_videos.ref_video_0": [
        "2",
        0
      ],
      "prompt": "crossview.",
      "width": [
        "ff_r_size",
        0
      ],
      "height": [
        "ff_r_size",
        1
      ],
      "length": [
        "2",
        3
