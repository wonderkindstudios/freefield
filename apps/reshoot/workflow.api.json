  },
  "ff_r_pick": {
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Second pass? (result)"
    },
    "inputs": {
      "switch": false,
      "on_false": [
        "37",
        0
      ],
      "on_true": [
        "ff_r_video",
        0
      ]
    }
  },
  "ff_r_frames": {
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Second pass? (frames for the original-audio result)"
    },
    "inputs": {
      "switch": false,
      "on_false": [
        "35",
        0
      ],
      "on_true": [
        "ff_r_decode",
        0
      ]
    }
  }
}
