  "ff_r_sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "ff_r_noise",
        0
      ],
      "guider": [
        "ff_r_guider",
        0
      ],
      "sampler": [
        "31",
        0
      ],
      "sigmas": [
        "ff_r_sigmas",
        0
      ],
      "latent_image": [
        "ff_r_latent",
        0
      ]
