  "ff_r_scale": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "First pass to 1.5 MP"
    },
    "inputs": {
      "image": [
        "35",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.5,
      "resolution_steps": 32
