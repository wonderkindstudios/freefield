        "4",
        0
      ],
      "azimuth": -30.0,
      "elevation": 20.0,
      "distance": 1.0,
      "hfov": 50.0,
      "vertical_shift": 0.0,
      "depth_ratio": 6.0,
      "smooth_depth": false,
      "invert_depth": false,
      "roll_lock": false,
      "pivot_override": false,
      "pivot_x": 0.0,
      "pivot_y": 0.0,
      "pivot_z": 1.05,
      "use_keyframes": false,
      "frame_count": 0,
      "keyframes": "",
      "interp_motion": "linear",
      "interpolation": "linear",
      "keep_source_aim": true,
      "preview_size": 384,
      "frame_index": 1
