    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "32": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "14",
        0
      ],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    }
  },
  "33": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "14",
        0
      ],
      "conditioning": [
        "21",
        0
      ]
    }
  },
  "34": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "30",
        0
      ],
      "guider": [
        "33",
        0
      ],
      "sampler": [
        "31",
        0
      ],
      "sigmas": [
        "32",
        0
      ],
      "latent_image": [
        "20",
        1
      ]
