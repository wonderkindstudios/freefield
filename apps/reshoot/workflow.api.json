    "inputs": {
      "clip": [
        "15",
        0
      ],
      "vae": [
        "16",
        0
      ],
      "audio_vae": [
        "17",
        0
      ],
      "ref_videos.ref_video_0": [
        "2",
        0
      ],
      "prompt": "crossview.",
      "width": [
        "2",
        1
      ],
      "height": [
        "2",
        2
      ],
      "length": [
        "2",
        3
      ],
      "ref_image_size": "match"
    }
  },
  "21": {
    "class_type": "MiniMaxH3AddGuide",
