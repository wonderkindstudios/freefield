  },
  "35": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "34",
        0
      ],
      "vae": [
        "16",
        0
      ]
    }
  },
  "36": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "34",
        0
      ],
      "vae": [
        "17",
        0
      ]
    }
  },
  "37": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "35",
        0
      ],
      "audio": [
        "36",
        0
      ],
      "fps": 24.0
    }
  },
  "38": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Result"
    },
    "inputs": {
      "video": [
        "ff_r_pick",
        0
      ],
      "filename_prefix": "freefield/reshoot",
      "format": "mp4",
      "format.codec": "h264"
    }
  },
  "40": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "fps": 24.0
    }
  },
  "41": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Warp guide"
    },
    "inputs": {
      "video": [
        "40",
        0
